# ==================== 集团医务室 药品进销存管理系统 ====================
# 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env

# ==================== 必填配置 ====================

# JWT_SECRET: 登录令牌签名密钥（必填，禁止使用默认值！）
# 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 建议使用至少 64 字符的随机十六进制字符串
JWT_SECRET=""

# ==================== 服务器配置 ====================

# 服务器监听端口（可选，默认 3000）
PORT=3000

# 运行环境: development | production
# 生产环境必须设置为 production，且 JWT_SECRET 不能为空
NODE_ENV="development"

# 日志级别: debug | info | warn | error
LOG_LEVEL="info"

# CORS 允许的来源域名，多个用逗号分隔（可选，默认 localhost:3000）
CORS_ORIGIN="http://localhost:3000"

# ==================== JWT 配置 ====================

# JWT 过期时间（可选，默认 24h）
# 支持单位: s(秒), m(分), h(时), d(天)
JWT_EXPIRES_IN="24h"

# ==================== 数据库配置 ====================

# 数据库路径（SQLite 文件路径，可选，默认 ./data/clinic.db）
DB_PATH="./data/clinic.db"

# ==================== 初始管理员 ====================

# 初始管理员账号（仅首次启动时生效，若用户表为空则创建）
INIT_ADMIN_USERNAME="admin"

# 初始管理员密码（首次启动后请立即修改）
# 密码要求: 至少 6 位字符
INIT_ADMIN_PASSWORD="CHANGE_ME_123456"

# ==================== 安全配置 ====================

# bcrypt 密码哈希难度因子（可选，默认 10，范围 4-31）
# 值越大越安全，但哈希速度越慢
BCRYPT_ROUNDS=10
